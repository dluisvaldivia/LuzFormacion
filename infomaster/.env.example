# URL del servicio RAG (carpeta rag/). En local: `uvicorn app.main:app --port 8000`
# Copia este fichero a .env.local y ajusta si hace falta.
VITE_RAG_URL=http://localhost:8000

# Unsplash: solo para `npm run photos`. Sin prefijo VITE_: no deben llegar al navegador.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APPLICATION_ID=
